{
  "rewrites": [
    {
      "source": "/((?!Iris.dmg|images/|favicon.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/Iris.dmg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Iris.dmg\""
        }
      ]
    }
  ]
}
